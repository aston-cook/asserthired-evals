{
  "name": "asserthired-evals",
  "version": "0.0.0",
  "private": true,
  "description": "LLM evaluation suite for interview-scoring applications. Reference implementation.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.0.0",
  "license": "MIT",
  "scripts": {
    "eval": "tsx scripts/run-evals.ts",
    "eval:smoke": "tsx scripts/run-evals.ts --smoke",
    "eval:redteam": "tsx scripts/run-evals.ts --config promptfooconfig.redteam.yaml --out-dir reports/redteam",
    "eval:redteam:smoke": "tsx scripts/run-evals.ts --smoke --config promptfooconfig.redteam.mock.yaml",
    "eval:summarize": "tsx scripts/summarize-run.ts",
    "eval:compare": "tsx scripts/compare-runs.ts",
    "eval:drift": "tsx scripts/detect-drift.ts",
    "review:queue": "tsx scripts/flag-for-review.ts",
    "calibrate:judge": "tsx scripts/calibrate-judge.ts",
    "validate:dataset": "tsx scripts/validate-dataset.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.90.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "promptfoo": "^0.121.5",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.4"
  }
}
